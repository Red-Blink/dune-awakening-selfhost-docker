# Local config / secrets
.env
.env.lock
runtime/secrets/
runtime/generated/
runtime/backups/
runtime/addons/
*.bak-before-*

# Runtime state / generated service configs
runtime/game/
runtime/rabbitmq-admin/
runtime/rabbitmq-game/
runtime/postgres/
runtime/director/
runtime/server-gateway/
runtime/fake-k8s-serviceaccount/

# Work/output
work/
*.log
*.tmp
.DS_Store
console/api/node_modules/
console/web/node_modules/
console/web/dist/
# A stray top-level node_modules/ (e.g. from running a test command at the
# repo root instead of console/api or console/web) is not covered by the two
# scoped rules above -- this closes that gap (review finding, upstream PR
# #202, 2026-09-08: a Vitest cache file, node_modules/.vite/vitest/.../
# results.json, had been committed this way).
/node_modules/
*.tsbuildinfo
**/bin/
**/obj/

# Python/cache
__pycache__/
*.pyc
.security-reports/
