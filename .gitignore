# Local config / secrets
.env
.env.lock
runtime/secrets/
runtime/generated/
runtime/backups/
runtime/addons/
*.bak-before-*

# Runtime state / generated service configs
runtime/game/
runtime/rabbitmq-admin/
runtime/rabbitmq-game/
runtime/postgres/
runtime/director/
runtime/server-gateway/
runtime/fake-k8s-serviceaccount/

# Work/output
work/
*.log
*.tmp
.DS_Store
console/api/node_modules/
console/web/node_modules/
console/web/dist/
*.tsbuildinfo
**/bin/
**/obj/

# Python/cache
__pycache__/
*.pyc
.security-reports/

# Never let a contributor's global ignore swallow tracked source. The standard
# VisualStudio gitignore template contains `Backup*/`, which on a
# case-insensitive filesystem (Windows, macOS) matches
# console/web/src/features/backups/ -- new files there were silently untracked
# with no warning. A repo .gitignore outranks core.excludesFile, so this wins.
# Scoped to console/ on purpose: runtime/backups/ above stays ignored.
!console/**/backups/
