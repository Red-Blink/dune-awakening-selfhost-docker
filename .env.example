# SERVER_IP is the address external clients should use.
# Use "auto" to detect the current public IPv4 at runtime, or set it manually.
SERVER_IP=auto

# SERVER_BIND_IP is the local interface/IP the game sockets listen on.
# Leave unset for auto-detection, or set it to the Docker host LAN/public interface IP.
# In NAT/port-forward setups, SERVER_BIND_IP is usually the LAN IP and SERVER_IP is the public WAN IP.
# Example:
# SERVER_BIND_IP=10.0.0.240
# SERVER_IP_MODE=public
# SERVER_IP=109.150.247.52
SERVER_IP_MODE=public
# SERVER_BIND_IP=

# Optional RabbitMQ route overrides. Native Linux automatically uses loopback
# when reachable and otherwise falls back to SERVER_BIND_IP for the game broker.
# The admin broker remains local-only unless explicitly overridden.
# DUNE_RMQ_GAME_HOST=
# DUNE_RMQ_ADMIN_HOST=

# Advanced legacy escape hatch only. Do not enable for NAT/port-forward hosting.
# DUNE_ALLOW_GAME_EXTERNAL_ADDRESS_OVERRIDE=0

# Advanced escape hatch only. In public NAT/double-NAT mode, keep Linux
# net.ipv4.ip_nonlocal_bind=0 so game sockets bind to SERVER_BIND_IP while
# advertising SERVER_IP. Set this only if you intentionally allow non-local
# public-IP binds and understand the routing impact.
# DUNE_ALLOW_PUBLIC_IP_NONLOCAL_BIND=0

# Advanced host-port overrides.
# A normal single-server installation should leave these unset and use the
# defaults shown below. Multi-server deployments behind one public IPv4 can
# assign every VM a globally unique host-port profile; see:
# docs/runtime/MULTI-SERVER-SINGLE-PUBLIC-IP.md
# POSTGRES_PORT=15432
# RMQ_ADMIN_PORT=32573
# RMQ_GAME_PORT=31982
# RMQ_GAME_HTTP_PORT=31983
# RMQ_GAME_LOCAL_HTTP_PORT=15672
# TEXT_ROUTER_PORT=5059
# DIRECTOR_PORT=11717
# METRICS_PROMETHEUS_PORT=9090
#
# Player/Game Port and IGWPort are authoritative UserEngine settings and should
# be changed through manager.sh/usersettings.py. CLIENT_PORT_BASE / IGW_PORT_BASE
# may be retained in .env as profile metadata but do not replace UserEngine.

# Public name players should see. Also used as the console's two-factor
# authenticator issuer name (Settings -> Two-Factor Authentication), so an
# operator running several installs can tell them apart in their
# authenticator app instead of seeing several identical "Dune Docker
# Console" entries.
SERVER_TITLE="My Dune Server"

# Region/farm label used by the game services and public directory. On first
# startup this also seeds the global Coriolis Cycle Start Hour to the
# region's UTC master schedule, if it has never been explicitly saved --
# Europe, North America, South America, Asia, or Oceania. Any other value
# (including one typed free-form here) leaves that field alone; configure it
# directly under Maps -> Modifiers -> Coriolis in the Web Console.
SERVER_REGION="Europe"

# Provider/datacenter label shown by Funcom server browser if supported.
SERVER_PROVIDER="dune-docker"

STEAM_APP_ID=4754530

# This must match the battlegroup/self-host identity authorized by the Funcom token.
# Example:
# BATTLEGROUP_ID=sh-xxxxxxxxxxxxxxxx-xxxxx
BATTLEGROUP_ID=

# Do NOT commit your Funcom Self-Host Service Token.
# Put it in:
# runtime/secrets/funcom-token.txt

# Optional Dune Docker Console web UI.
# The installer records the existing main Compose project here so upgrades keep
# using the same Docker volumes. Normally this is discovered automatically.
DUNE_COMPOSE_PROJECT_NAME=
ADMIN_BIND_HOST=auto
ADMIN_BIND_PORT=8088
ADMIN_AUTH_DISABLED=0
ADMIN_SECURE_COOKIES=0
ADMIN_PASSWORD=
ADMIN_TASK_RETENTION=200
# Completed market activity is retained indefinitely by default. Set 7-3650
# to remove older Console-owned transaction-history rows automatically.
ADMIN_MARKET_HISTORY_RETENTION_DAYS=0
ADMIN_COMMAND_TIMEOUT_MS=120000
ADMIN_MAX_JSON_BYTES=2097152
ADMIN_DB_POOL_SIZE=5
ADMIN_DB_CONNECT_TIMEOUT_MS=3000
ADMIN_DB_QUERY_TIMEOUT_MS=15000
ADMIN_DB_STATEMENT_TIMEOUT_MS=15000
ALLOW_HOST_BOOTSTRAP=false
ADMIN_MOCK_MODE=0

# Optional read-only GitHub token. Raises GitHub API limits for Console updates
# and community-addon catalog reads. Do not commit a real token.
# DUNE_SELF_UPDATE_TOKEN=
# Maximum time allowed for rebuilding the Web Console during a stack update.
DUNE_SELF_UPDATE_BUILD_TIMEOUT_SECONDS=1800

# Number of unattended Market Bot backups retained across seed, buyback, and
# unseed jobs. Manual, automatic, and safety backups are not counted.
DUNE_MARKET_BOT_BACKUP_KEEP=5
DUNE_VEHICLE_DELETE_BACKUP_KEEP=10
DUNE_BASE_DELETE_BACKUP_KEEP=10

# Generator refill tuning.
ADMIN_REFILL_FLUSH_INTERVAL_MS=5000
ADMIN_REFILL_DOWN_DWELL_MS=30000
ADMIN_REFILL_MAX_AGE_MS=604800000
ADMIN_REFILL_RETRY_DELAY_MS=60000

# Auto-refill thresholds and scan intervals. These four are the FALLBACK only:
# the Bases panel's gear icon writes runtime/generated/auto-refill-settings.json,
# which wins over anything set here, and each field there has a Reset that drops
# back to these values. Editing them is only worth it to change the starting
# point for a fresh install, or to script one. An unparseable value falls back to
# the documented default; an out-of-range one is clamped to the nearest bound.
# A blank value reads as unset, but note docker-compose.web.yml substitutes its
# own default for a blank, so that only applies when running outside Docker.
#
# Generators and water are independent: separate enrollment lists, separate
# schedules, so a base enrolled in one is not enrolled in the other.
ADMIN_AUTO_REFILL_THRESHOLD_PERCENT=50
ADMIN_AUTO_REFILL_INTERVAL_HOURS=24
ADMIN_AUTO_REFILL_WATER_THRESHOLD_PERCENT=50
ADMIN_AUTO_REFILL_WATER_INTERVAL_HOURS=24

# Base-delete queue tuning. Same shape as the generator refill queue above:
# a delete queued for a live map is dropped after MAX_AGE_MS without applying,
# and a failed flush attempt waits RETRY_DELAY_MS before retrying.
ADMIN_BASE_DELETE_MAX_AGE_MS=604800000
ADMIN_BASE_DELETE_RETRY_DELAY_MS=60000

# How long a restart waits for queued map writes to flush between its stop and
# start halves. Past this the restart reports the overrun and carries on rather
# than leaving the battlegroup down; the writes stay queued for a later pass.
ADMIN_MAP_WRITE_FLUSH_TIMEOUT_MS=300000

# Public servers are listed automatically on https://dunedocker.app.
# Set this to false to opt out while keeping SERVER_IP_MODE=public.
# Listed servers also receive automatic personalized browser latency checks.
# No additional fixed probe port or port forwarding is required.
# DUNE_PUBLIC_DIRECTORY_ENABLED=true
# Share an anonymous active-server count even when the server is unlisted or local.
# This sends no server name, address, player count, or gameplay configuration.
# DUNE_ANONYMOUS_SERVER_COUNT_ENABLED=true
# Optional separate directory endpoint for claim verification during staging tests.
# When unset, claims use the normal public directory endpoint.
# DUNE_PUBLIC_DIRECTORY_CLAIM_URL=https://beta.dunedocker.app/api/v1/servers
# Optional Discord community invite shown with this server's public listing.
# DUNE_PUBLIC_DIRECTORY_DISCORD_INVITE=https://discord.gg/your-invite

# Optional experimental read-only Discord adapter API.
# Disabled by default. Use a strong random token or a token file path.
DUNE_DISCORD_ADAPTER_ENABLED=false
# Enable Discord adapter write operations such as broadcast. Disabled by default.
# DUNE_DISCORD_WRITES_ENABLED=0
# DUNE_DISCORD_ADAPTER_TOKEN=
# DUNE_DISCORD_ADAPTER_TOKEN_FILE=
# DISCORD_OBSERVER_ROLE_IDS=
# DISCORD_ADMIN_ROLE_IDS=
# DISCORD_OWNER_ROLE_IDS=

# Optional direct database overrides for the web admin.
# ADMIN_DATABASE_URL=postgres://dune:dune@127.0.0.1:15432/dune
# DUNE_DB_HOST=127.0.0.1
# DUNE_DB_PORT=15432
# DUNE_DB_NAME=dune
# DUNE_DB_USER=dune
# DUNE_DB_PASSWORD=dune

# Optional RabbitMQ/server-command override. Normally the web admin uses the
# upstream command-auth token expected by the game server.
# DUNE_COMMAND_AUTH_TOKEN=

# Optional (off by default): makes an opt-in TOTP second factor for the
# password console login available (RFC docs/rfc-console-auth.md §2.3/§4).
#
# Setting this to 1 does NOT change how you log in by itself -- it only makes
# a "Two-Factor Authentication" section appear in Settings. Your next login is
# unaffected either way. (Earlier versions of this feature forced enrollment
# on the very next login with no opt-out; live-testing feedback was that this
# was the wrong default for a self-hosted tool, so enrollment is now something
# you start yourself, whenever you're ready -- issue #665.)
#
# Once you turn the flag on, from Settings -> Two-Factor Authentication ->
# Enable Two-Factor Authentication:
#
#   * Enabling puts you into a 10-minute, one-time authenticator enrollment.
#     Nothing else in the console is reachable until you finish it.
#   * Enrollment shows a QR code and 10 single-use recovery codes ONCE. They are
#     never shown again and are stored only as hashes. If you close that screen
#     without saving them, they are gone.
#   * From then on, every password login also requires a 6-digit code from the
#     authenticator you enrolled.
#   * If you lose BOTH the authenticator and the recovery codes, the only way
#     back in is a host-filesystem reset -- see
#     docs/console/two-factor-recovery.md. Read that BEFORE you enable this, not
#     after you are locked out.
#   * A "Disable Two-Factor Authentication" control (same Settings section)
#     lets you turn it back off yourself, any time, with the same password +
#     current-code proof.
#
# Enable it (from Settings) when you are sitting in front of the console with
# your authenticator app open and somewhere to save the recovery codes -- not
# as part of an unattended session.
#
# UNSET/0 (the default) hides the Settings control entirely -- password login
# stays exactly as today (single factor), and the feature isn't offered at all.
# Turning the flag back off after enrolling restores single-factor login and
# leaves your enrolled state intact, so re-enabling the FLAG does not force a
# second enrollment (using the Settings "Disable" control instead does delete
# it, on purpose -- see docs/console/authentication-upgrade-guide.md).
#
# State is stored in runtime/generated/console-second-factor.json (mode 0600).
# Back it up with the rest of runtime/generated/ if you back that up at all.
# CONSOLE_TOTP_ENABLED=0

# Optional, and unrelated to any single feature above: the login rate limiter
# (8 failed attempts / 15 min per key, 32 / 15 min aggregate) normally keys on
# the raw TCP peer address. If the console sits behind a reverse proxy or
# tunnel (Cloudflare Tunnel, nginx, etc.), every real visitor shares that one
# proxy address, so one attacker or one confused user can lock out everyone
# else -- including yourself.
#
# Set this to your proxy's own exact IP address(es), comma-separated, to trust
# its X-Forwarded-For header for that key instead. UNSET (the default) never
# trusts any forwarded header from anyone, which is correct and safe if you
# are not running a reverse proxy in front of the console.
#
# Only exact IPs, no CIDR ranges. Deliberately generic, not Cloudflare-only --
# works for any reverse proxy that sets X-Forwarded-For.
# CONSOLE_TRUSTED_PROXY_IPS=

# Optional: Discord OAuth sign-in for the Web Console (docs/rfc-console-auth.md §2.1).
# All keys below are optional; if any required one is missing, the console
# behaves exactly as before (password sign-in only, single owner). To enable:
#   1. Create an OAuth2 application in the Discord Developer Portal.
#   2. DISCORD_OAUTH_CLIENT_ID and DISCORD_OAUTH_CLIENT_SECRET (or write the
#      secret to runtime/secrets/discord-oauth-client-secret.txt; the file is
#      never auto-created).
#   3. DISCORD_OAUTH_REDIRECT_URI must match the application's registered
#      redirect exactly (e.g. https://console.example.com/api/auth/discord/callback).
#   4. DISCORD_HOME_GUILD_ID = your server's Discord guild (snowflake).
#   5. Owner needs no configuration: whoever Discord reports as the owner of
#      DISCORD_HOME_GUILD_ID signs in as the console Owner (see the role
#      mapping block below). DISCORD_OAUTH_ALLOW_OWNER_BOOTSTRAP=1 plus a
#      DISCORD_OAUTH_OWNER_ALLOWLIST of user snowflakes (comma-separated) is
#      an ADVANCED way to grant owner to additional accounts. Keep the
#      allowlist minimal: each entry is a standing owner credential. With the
#      bot handoff configured (below), tiers come from the bot instead and the
#      allowlist and role mapping are not consulted.
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URI=
# DISCORD_OAUTH_BASE_URL=https://discord.com/api/v10
# DISCORD_OAUTH_ALLOW_OWNER_BOOTSTRAP=0
# DISCORD_OAUTH_OWNER_ALLOWLIST=
# DISCORD_HOME_GUILD_ID=

# DISCORD_OAUTH_DISABLED: managed by Settings -> Discord OAuth's "Disable"/
# "Enable" buttons, not meant to be hand-edited. When "1", Discord sign-in is
# suspended (password-only) but the application settings above are kept, not
# deleted -- "Enable" clears this and restores Discord sign-in immediately.
# DISCORD_OAUTH_DISABLED=0

# Optional: signed handoff for tiered console roles.
# When DISCORD_BOT_HANDOFF_SECRET (or the secrets-file at
# runtime/secrets/discord-bot-handoff-secret.txt), DISCORD_BOT_HANDOFF_URL,
# and DISCORD_HOME_GUILD_ID are all configured, the console calls a companion bot
# to resolve each Discord user's effective tier via a signed HMAC handoff
# instead of only offering the owner bootstrap. The handoff is
# all-or-nothing: set all three values (with an http/https URL) or none.
# Half-configured ⇒ Discord sign-in is disabled with a boot warning naming
# the missing/invalid value (password sign-in unaffected). Fully
# unconfigured ⇒ tiers come from guild ownership, the role mapping below and
# the optional owner allowlist. Fully configured ⇒ the bot's answer is authoritative: a bot
# outage denies NEW Discord sign-ins (active sessions unaffected) rather
# than falling back to the owner allowlist.
# DISCORD_BOT_HANDOFF_SECRET=
# DISCORD_BOT_HANDOFF_URL=

# Role -> tier mapping for Discord sign-in (docs/rfc-console-auth.md §2.1.1).
# The same information the companion bot's setup form asks for, as manual
# entries: copy each role's ID from Discord (User Settings -> Advanced ->
# Developer Mode, then right-click the role -> Copy Role ID). One or more IDs
# per tier, comma-separated. At sign-in the console reads the member's own
# roles in DISCORD_HOME_GUILD_ID and grants the HIGHEST mapped tier
# (admin > moderator > player). A member holding no mapped role is denied --
# unless they are the server's owner (Owner) or on the owner allowlist.
# These are ignored entirely when a bot handoff is configured -- the bot stays
# the single source of truth.
#
# OWNER IS NOT A ROLE. The console grants Owner to whoever Discord reports as
# the owner of DISCORD_HOME_GUILD_ID (exactly one person, by Discord's rule) --
# nothing to configure, and no role can ever confer it. Map at least an Admin
# role, or only the server owner can use the console through Discord.
# (DISCORD_OAUTH_OWNER_ALLOWLIST above still works as an ADVANCED way to add
# further owner user IDs; it is not offered in the settings form.)
# DISCORD_CONSOLE_ADMIN_ROLE_IDS=
# DISCORD_CONSOLE_MODERATOR_ROLE_IDS=
# DISCORD_CONSOLE_PLAYER_ROLE_IDS=

# Require the Discord ACCOUNT to have two-factor enabled before granting these
# tiers via Discord sign-in (read from Discord's own mfa_enabled flag -- no
# extra enrollment in the console). OFF unless set -- an existing operator whose
# Discord account has no 2FA must not lose sign-in on upgrade. "owner,admin" is
# the recommended value and what the Settings form suggests. This is about the
# Discord account's factor; the console's own authenticator
# (CONSOLE_TOTP_ENABLED) applies to password sign-in only.
# DISCORD_OAUTH_REQUIRE_MFA_TIERS=

# Optional runtime path override when the web admin is run outside this repo.
# DUNE_DOCKER_DIR=/path/to/dune-awakening-selfhost-docker
