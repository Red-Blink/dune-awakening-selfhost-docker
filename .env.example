# SERVER_IP is the address external clients should use.
# Use "auto" to detect the current public IPv4 at runtime, or set it manually.
SERVER_IP=auto

# SERVER_BIND_IP is the local interface/IP the game sockets listen on.
# Leave unset for auto-detection, or set it to the Docker host LAN/public interface IP.
# In NAT/port-forward setups, SERVER_BIND_IP is usually the LAN IP and SERVER_IP is the public WAN IP.
# Example:
# SERVER_BIND_IP=10.0.0.240
# SERVER_IP_MODE=public
# SERVER_IP=109.150.247.52
SERVER_IP_MODE=public
# SERVER_BIND_IP=

# Optional RabbitMQ route overrides. Native Linux automatically uses loopback
# when reachable and otherwise falls back to SERVER_BIND_IP for the game broker.
# The admin broker remains local-only unless explicitly overridden.
# DUNE_RMQ_GAME_HOST=
# DUNE_RMQ_ADMIN_HOST=

# Advanced legacy escape hatch only. Do not enable for NAT/port-forward hosting.
# DUNE_ALLOW_GAME_EXTERNAL_ADDRESS_OVERRIDE=0

# Advanced escape hatch only. In public NAT/double-NAT mode, keep Linux
# net.ipv4.ip_nonlocal_bind=0 so game sockets bind to SERVER_BIND_IP while
# advertising SERVER_IP. Set this only if you intentionally allow non-local
# public-IP binds and understand the routing impact.
# DUNE_ALLOW_PUBLIC_IP_NONLOCAL_BIND=0

# Advanced host-port overrides.
# A normal single-server installation should leave these unset and use the
# defaults shown below. Multi-server deployments behind one public IPv4 can
# assign every VM a globally unique host-port profile; see:
# docs/runtime/MULTI-SERVER-SINGLE-PUBLIC-IP.md
# POSTGRES_PORT=15432
# RMQ_ADMIN_PORT=32573
# RMQ_GAME_PORT=31982
# RMQ_GAME_HTTP_PORT=31983
# RMQ_GAME_LOCAL_HTTP_PORT=15672
# TEXT_ROUTER_PORT=5059
# DIRECTOR_PORT=11717
# METRICS_PROMETHEUS_PORT=9090
#
# Player/Game Port and IGWPort are authoritative UserEngine settings and should
# be changed through manager.sh/usersettings.py. CLIENT_PORT_BASE / IGW_PORT_BASE
# may be retained in .env as profile metadata but do not replace UserEngine.

# Public name players should see.
SERVER_TITLE="My Dune Server"

# Region/farm label used by the game services and public directory. On first
# startup this also seeds the global Coriolis Cycle Start Hour to the
# region's UTC master schedule, if it has never been explicitly saved --
# Europe, North America, South America, Asia, or Oceania. Any other value
# (including one typed free-form here) leaves that field alone; configure it
# directly under Maps -> Modifiers -> Coriolis in the Web Console.
SERVER_REGION="Europe"

# Provider/datacenter label shown by Funcom server browser if supported.
SERVER_PROVIDER="dune-docker"

STEAM_APP_ID=4754530

# This must match the battlegroup/self-host identity authorized by the Funcom token.
# Example:
# BATTLEGROUP_ID=sh-xxxxxxxxxxxxxxxx-xxxxx
BATTLEGROUP_ID=

# Do NOT commit your Funcom Self-Host Service Token.
# Put it in:
# runtime/secrets/funcom-token.txt

# Optional Dune Docker Console web UI.
# The installer records the existing main Compose project here so upgrades keep
# using the same Docker volumes. Normally this is discovered automatically.
DUNE_COMPOSE_PROJECT_NAME=
ADMIN_BIND_HOST=auto
ADMIN_BIND_PORT=8088
ADMIN_AUTH_DISABLED=0
ADMIN_SECURE_COOKIES=0
ADMIN_PASSWORD=
ADMIN_TASK_RETENTION=200
# Completed market activity is retained indefinitely by default. Set 7-3650
# to remove older Console-owned transaction-history rows automatically.
ADMIN_MARKET_HISTORY_RETENTION_DAYS=0
ADMIN_COMMAND_TIMEOUT_MS=120000
ADMIN_MAX_JSON_BYTES=2097152
# How many encrypted system backups to keep. 0 keeps every one, matching
# DB_AUTO_BACKUP_RETENTION_DAYS. Pruning is opt-in because each archive is the
# only copy of the credentials inside it.
DUNE_SYSTEM_BACKUP_KEEP=0
ADMIN_DB_POOL_SIZE=5
ADMIN_DB_CONNECT_TIMEOUT_MS=3000
ADMIN_DB_QUERY_TIMEOUT_MS=15000
ADMIN_DB_STATEMENT_TIMEOUT_MS=15000
ALLOW_HOST_BOOTSTRAP=false
ADMIN_MOCK_MODE=0

# Optional read-only GitHub token. Raises GitHub API limits for Console updates
# and community-addon catalog reads. Do not commit a real token.
# DUNE_SELF_UPDATE_TOKEN=
# Maximum time allowed for rebuilding the Web Console during a stack update.
DUNE_SELF_UPDATE_BUILD_TIMEOUT_SECONDS=1800

# Number of unattended Market Bot backups retained across seed, buyback, and
# unseed jobs. Manual, automatic, and safety backups are not counted.
DUNE_MARKET_BOT_BACKUP_KEEP=5
DUNE_VEHICLE_DELETE_BACKUP_KEEP=10
DUNE_BASE_DELETE_BACKUP_KEEP=10

# Generator refill tuning.
ADMIN_REFILL_FLUSH_INTERVAL_MS=5000
ADMIN_REFILL_DOWN_DWELL_MS=30000
ADMIN_REFILL_MAX_AGE_MS=604800000
ADMIN_REFILL_RETRY_DELAY_MS=60000

# Auto-refill thresholds and scan intervals. These four are the FALLBACK only:
# the Bases panel's gear icon writes runtime/generated/auto-refill-settings.json,
# which wins over anything set here, and each field there has a Reset that drops
# back to these values. Editing them is only worth it to change the starting
# point for a fresh install, or to script one. An unparseable value falls back to
# the documented default; an out-of-range one is clamped to the nearest bound.
# A blank value reads as unset, but note docker-compose.web.yml substitutes its
# own default for a blank, so that only applies when running outside Docker.
#
# Generators and water are independent: separate enrollment lists, separate
# schedules, so a base enrolled in one is not enrolled in the other.
ADMIN_AUTO_REFILL_THRESHOLD_PERCENT=50
ADMIN_AUTO_REFILL_INTERVAL_HOURS=24
ADMIN_AUTO_REFILL_WATER_THRESHOLD_PERCENT=50
ADMIN_AUTO_REFILL_WATER_INTERVAL_HOURS=24

# Base-delete queue tuning. Same shape as the generator refill queue above:
# a delete queued for a live map is dropped after MAX_AGE_MS without applying,
# and a failed flush attempt waits RETRY_DELAY_MS before retrying.
ADMIN_BASE_DELETE_MAX_AGE_MS=604800000
ADMIN_BASE_DELETE_RETRY_DELAY_MS=60000

# How long a restart waits for queued map writes to flush between its stop and
# start halves. Past this the restart reports the overrun and carries on rather
# than leaving the battlegroup down; the writes stay queued for a later pass.
ADMIN_MAP_WRITE_FLUSH_TIMEOUT_MS=300000

# Public servers are listed automatically on https://dunedocker.app.
# Set this to false to opt out while keeping SERVER_IP_MODE=public.
# Listed servers also receive automatic personalized browser latency checks.
# No additional fixed probe port or port forwarding is required.
# DUNE_PUBLIC_DIRECTORY_ENABLED=true
# Share an anonymous active-server count even when the server is unlisted or local.
# This sends no server name, address, player count, or gameplay configuration.
# DUNE_ANONYMOUS_SERVER_COUNT_ENABLED=true
# Optional separate directory endpoint for claim verification during staging tests.
# When unset, claims use the normal public directory endpoint.
# DUNE_PUBLIC_DIRECTORY_CLAIM_URL=https://beta.dunedocker.app/api/v1/servers
# Optional Discord community invite shown with this server's public listing.
# DUNE_PUBLIC_DIRECTORY_DISCORD_INVITE=https://discord.gg/your-invite

# Optional experimental read-only Discord adapter API.
# Disabled by default. Use a strong random token or a token file path.
DUNE_DISCORD_ADAPTER_ENABLED=false
# Enable Discord adapter write operations such as broadcast. Disabled by default.
# DUNE_DISCORD_WRITES_ENABLED=0
# DUNE_DISCORD_ADAPTER_TOKEN=
# DUNE_DISCORD_ADAPTER_TOKEN_FILE=
# DISCORD_OBSERVER_ROLE_IDS=
# DISCORD_ADMIN_ROLE_IDS=
# DISCORD_OWNER_ROLE_IDS=

# Optional direct database overrides for the web admin.
# ADMIN_DATABASE_URL=postgres://dune:dune@127.0.0.1:15432/dune
# DUNE_DB_HOST=127.0.0.1
# DUNE_DB_PORT=15432
# DUNE_DB_NAME=dune
# DUNE_DB_USER=dune
# DUNE_DB_PASSWORD=dune

# Optional RabbitMQ/server-command override. Normally the web admin uses the
# upstream command-auth token expected by the game server.
# DUNE_COMMAND_AUTH_TOKEN=

# Optional runtime path override when the web admin is run outside this repo.
# DUNE_DOCKER_DIR=/path/to/dune-awakening-selfhost-docker
